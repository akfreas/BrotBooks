// The Testing configuration: Debug code, signed ad hoc with no iCloud entitlements, so UI tests and simulator
// runs need no provisioning profile. The app falls back to its on-device store. Used by the test actions.
#include "BrotBooks.xcconfig"

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
CODE_SIGN_ENTITLEMENTS = Config/BrotBooks-Local.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = Config/BrotBooks-Local.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=iphone*] = Config/BrotBooks-Local.entitlements
